{
  "name": "neoms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.7.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,client \"npm run dev -w @neoms/server\" \"npm run dev -w @neoms/worker\" \"npm run dev -w @neoms/client\"",
    "dev:worker": "npm run dev -w @neoms/worker",
    "dev:mac": "npm run tauri -w @neoms/client -- dev --config '{\"build\":{\"beforeDevCommand\":\"\"}}'",
    "typecheck": "tsc --noEmit && npm run typecheck -w @neoms/client",
    "build": "npm run build -w @neoms/client && tsc",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up --local",
    "setup:env": "node scripts/setup-env.mjs",
    "demo": "tsx --env-file=.env scripts/demo.ts",
    "build:mac": "npm run tauri -w @neoms/client -- build --bundles app",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@supabase/supabase-js": "2.117.2",
    "hono": "4.13.12",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "pg-boss": "12.35.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "supabase": "2.119.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
